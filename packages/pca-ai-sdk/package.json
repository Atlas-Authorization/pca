{
  "name": "@atlasauth/pca-ai-sdk",
  "version": "0.3.0",
  "description": "Vercel AI SDK adapter for Proof-Carrying Authority: wrap an AI SDK tool so every call emits a PCActn (and attaches the proof) before execute runs.",
  "keywords": [
    "vercel ai sdk",
    "tool calling",
    "middleware",
    "agent authorization",
    "proof-carrying authority",
    "pca",
    "ai agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Atlas-Authorization/pca#readme",
  "bugs": {
    "url": "https://github.com/Atlas-Authorization/pca/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/pca.git",
    "directory": "packages/pca-ai-sdk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/pca": "workspace:*"
  },
  "peerDependencies": {
    "ai": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
