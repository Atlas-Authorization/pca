{
  "name": "@atlasauth/pca-analyzer",
  "version": "0.3.0",
  "description": "Static authority analyzer for Proof-Carrying Authority: a sound, bounded decision procedure over PCA's predicate/caveat policy (reachability, vacuity/totality, delegation-safety subsumption, disjointness, equivalence, and declared-intent conformance) with counterexamples.",
  "keywords": [
    "static analysis",
    "policy analysis",
    "reachability",
    "agent authorization",
    "proof-carrying authority",
    "pca",
    "ai agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Atlas-Authorization/pca#readme",
  "bugs": {
    "url": "https://github.com/Atlas-Authorization/pca/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/pca.git",
    "directory": "packages/pca-analyzer"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/pca": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
