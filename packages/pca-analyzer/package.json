{
  "name": "@atlasauth/pca-analyzer",
  "version": "0.5.0",
  "description": "Static authority analyzer for Proof-Carrying Authority: a sound, bounded decision procedure over PCA's predicate/caveat policy (reachability, totality, subsumption, equivalence, intent conformance) plus analysis and authoring tools built on it: maximum exposure, escalation surface, semantic diff, residual policies and capability discovery, SQL data filters, least-privilege proposals, policy coverage, minimal-change repairs, schema validation and a policy test runner. Counterexamples are always re-checked by the real evaluator.",
  "keywords": [
    "static analysis",
    "policy analysis",
    "reachability",
    "agent authorization",
    "proof-carrying authority",
    "pca",
    "ai agents",
    "maximum exposure",
    "residual policies",
    "least privilege",
    "policy coverage"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Atlas-Authorization/pca#readme",
  "bugs": {
    "url": "https://github.com/Atlas-Authorization/pca/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/pca.git",
    "directory": "packages/pca-analyzer"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/pca": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "pca": {
    "maturity": "production",
    "pending_ci": true
  }
}
