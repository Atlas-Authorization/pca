{
  "name": "@atlasauth/pca-fndsa-wasm",
  "version": "0.3.0",
  "description": "FN-DSA (Falcon, FIPS 206) signature backend for @atlasauth/pca: FN-DSA-512 / FN-DSA-1024 keygen, signing and verification from the vetted pure-Rust fn-dsa crate family (Thomas Pornin) compiled to WebAssembly. Verification is the PCA verifier's public-key operation.",
  "keywords": [
    "fn-dsa",
    "falcon",
    "fips 206",
    "webassembly",
    "wasm",
    "post-quantum signatures",
    "agent authorization",
    "proof-carrying authority",
    "pca",
    "ai agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Atlas-Authorization/pca#readme",
  "bugs": {
    "url": "https://github.com/Atlas-Authorization/pca/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/pca.git",
    "directory": "packages/pca-fndsa-wasm"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm",
    "crate",
    "README.md",
    "LICENSE",
    "!crate/target"
  ],
  "scripts": {
    "build:wasm": "cd crate && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/pca_fndsa_wasm.wasm ../wasm/pca_fndsa_wasm.wasm && cargo clean",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
