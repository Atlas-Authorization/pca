{
  "name": "@atlasauth/pca-policy-ci",
  "version": "0.2.0",
  "description": "CI gate for PCA policies: statically flag over-broad grants, privilege-escalation in delegation chains, unused/redundant caveats, and reachability of dangerous actions — fail the build before an unsafe policy ships.",
  "keywords": [
    "policy",
    "ci",
    "static analysis",
    "linting",
    "agent authorization",
    "proof-carrying authority",
    "pca",
    "ai agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Atlas-Authorization/pca#readme",
  "bugs": {
    "url": "https://github.com/Atlas-Authorization/pca/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/pca.git",
    "directory": "packages/pca-policy-ci"
  },
  "bin": {
    "pca-policy-ci": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/pca": "workspace:*",
    "@atlasauth/pca-analyzer": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
