{
  "name": "@atlasauth/pca",
  "version": "0.2.0",
  "description": "Proof-Carrying Authority core: canonical hashing, Ed25519 and post-quantum signatures, Merkle plan commitments, attenuable capability chains, hardware attestation verification, and the PCActn verifier.",
  "keywords": [
    "capability",
    "delegation",
    "attestation",
    "post-quantum",
    "ed25519",
    "ml-dsa",
    "fn-dsa",
    "verifier",
    "tee",
    "merkle",
    "agent authorization",
    "proof-carrying authority",
    "pca",
    "ai agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Atlas-Authorization/pca#readme",
  "bugs": {
    "url": "https://github.com/Atlas-Authorization/pca/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/pca.git",
    "directory": "packages/pca"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./durable-state": {
      "types": "./dist/durable-state.d.ts",
      "default": "./dist/durable-state.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "tsx examples/pca-loop.ts"
  },
  "dependencies": {
    "@atlasauth/pca-fndsa-wasm": "workspace:*",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.4.1",
    "@scure/base": "^1.2.6"
  },
  "optionalDependencies": {
    "@atlasauth/pca-less-wasm": "workspace:*",
    "@xmldom/xmldom": "0.8.10",
    "asn1js": "3.0.10",
    "pkijs": "3.4.1",
    "snarkjs": "^0.7.5",
    "xml-crypto": "6.1.2"
  },
  "devDependencies": {
    "circomlib": "^2.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "circuits/*.circom",
    "circuits/*.sh",
    "circuits/*vkey.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
