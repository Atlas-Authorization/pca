{
  "name": "@atlasauth/pca-mpc-wasm",
  "version": "0.2.0",
  "description": "Constant-time Ed25519 base-OT curve core (curve25519-dalek, compiled to WebAssembly): a drop-in, genuinely constant-time replacement for @atlasauth/pca-mpc's pure-BigInt ec.ts curve ops.",
  "keywords": [
    "curve25519",
    "constant-time",
    "oblivious transfer",
    "webassembly",
    "wasm",
    "agent authorization",
    "proof-carrying authority",
    "pca",
    "ai agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Atlas-Authorization/pca#readme",
  "bugs": {
    "url": "https://github.com/Atlas-Authorization/pca/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/pca.git",
    "directory": "packages/pca-mpc-wasm"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm",
    "crate",
    "README.md",
    "LICENSE",
    "!crate/target"
  ],
  "scripts": {
    "build:wasm": "cd crate && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/pca_mpc_wasm.wasm ../wasm/pca_mpc_wasm.wasm",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@noble/curves": "^1.9.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
