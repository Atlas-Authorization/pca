{
  "name": "@atlasauth/pca-mpc",
  "version": "0.5.0",
  "description": "Multi-stakeholder policy VM composed under secure multi-party computation (semi-honest additive secret sharing over a prime field, malicious-with-abort SPDZ-style layer, post-quantum base-OT) with a mutual-TLS networked runner. Experimental reference prototype.",
  "keywords": [
    "secure multi-party computation",
    "mpc",
    "oblivious transfer",
    "policy vm",
    "prototype",
    "agent authorization",
    "proof-carrying authority",
    "pca",
    "ai agents",
    "tls"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Atlas-Authorization/pca#readme",
  "bugs": {
    "url": "https://github.com/Atlas-Authorization/pca/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/pca.git",
    "directory": "packages/pca-mpc"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./net": {
      "types": "./dist/net/index.d.ts",
      "default": "./dist/net/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/pca": "workspace:*",
    "@atlasauth/pca-mpc-lwe-ot-wasm": "workspace:*",
    "@atlasauth/pca-mpc-wasm": "workspace:*",
    "@noble/post-quantum": "^0.4.1"
  },
  "devDependencies": {
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pca-mpc-node": "./dist/net/party-main.js"
  },
  "pca": {
    "maturity": "hardened"
  }
}
