{
  "name": "@atlasauth/pca-goal",
  "version": "0.5.0",
  "private": true,
  "description": "Goal IR for PCA goal-to-decision: a typed, signed Goal compiled by a deterministic, machine-proved compiler (Dafny, extracted) into a policy with a witness for every Allow; lossless card render/parse.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/pca-verified-core": "workspace:*",
    "@atlasauth/pca": "workspace:*",
    "@atlasauth/pca-intent": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pca": {
    "maturity": "hardened"
  }
}
