{
  "name": "@atlasauth/pca-compliance",
  "version": "0.2.0",
  "description": "Compliance export for PCA: render PCA proofs + decision records (incl. delegation chain + human-override) into auditor-ready reports pre-mapped to EU AI Act Art. 12/50, ISO 42001 clauses, and SOC 2 CC6.",
  "keywords": [
    "compliance",
    "eu ai act",
    "audit",
    "reporting",
    "agent authorization",
    "proof-carrying authority",
    "pca",
    "ai agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Atlas-Authorization/pca#readme",
  "bugs": {
    "url": "https://github.com/Atlas-Authorization/pca/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/pca.git",
    "directory": "packages/pca-compliance"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/pca": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
