# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Rust / wasm build artifacts (crate sources are committed; their targets are not)
target/
pkg/

# Test / coverage
coverage/
.nyc_output/

# Logs & caches
*.log
npm-debug.log*
pnpm-debug.log*
# ...but tracked transcripts are content, not logs: test fixtures (sha256-pinned in each PROVENANCE.json) and the
# prover result logs the assembly keeps under formal/ (larger ones are listed in OMITTED-LARGE-LOGS.txt instead)
!packages/*/fixtures/**/*.log
!formal/**/*.log
.cache/
.turbo/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local env
.env
.env.*
!.env.example
