     zs <-R zkseed;
     img: zkimg <- zkimgof(zs);
     zsk: zkkey <- zkskgen(zs);
     return(pkP, img);
     ((
       ch1() :=
       return(hk_1)
     ) | (
       foreach iP <= NP do
       cP(sid: sid_t, vh_1: lval, v1: lval, vm_1: lval, vl: lval) :=
       r0 <-R salt;
       r1 <-R salt;
       r2 <-R salt;
       r3 <-R salt;
       l0: hout <- H(hk_1, leafin(tH, r0, vh_1));
       l1: hout <- H(hk_1, leafin(tC, r1, v1));
       l2: hout <- H(hk_1, leafin(tM, r2, vm_1));
       l3: hout <- H(hk_1, leafin(tL, r3, vl));
       root: hout <- H(hk_1, nodein(H(hk_1, nodein(l0, l1)), H(hk_1, nodein(l2, l3))));
       cm: hout <- H(hk_1, commitin(s4, root));
       event Committed(sid, cm, vh_1, r0, v1, r1, vm_1, r2);
       return(cm, sign(mkgrant(sid, cm), skP), r0, r1, r2, r3)
     ) | (
       foreach iG <= NG do
       cG(x_1: act_t, s_1: sid_t, c_1: hout, e_1: eps_t, vh_2: lval, rh: salt, ah1: hout, ah2: hout, vc: lval, rc: salt, ac1: hout, ac2: hout, vm_2: lval, rm: salt, am1: hout, am2: hout) :=
       rooth: hout <- H(hk_1, nodein(H(hk_1, nodein(H(hk_1, leafin(tH, rh, vh_2)), ah1)), ah2));
       rootc: hout <- H(hk_1, nodein(H(hk_1, nodein(ac1, H(hk_1, leafin(tC, rc, vc)))), ac2));
       rootm: hout <- H(hk_1, nodein(am2, H(hk_1, nodein(H(hk_1, leafin(tM, rm, vm_2)), am1))));
       if c_1 = H(hk_1, commitin(s4, rooth)) then
       if c_1 = H(hk_1, commitin(s4, rootc)) then
       if cellof1(vh_2, x_1) then
       if in_grant(vc) then
       if risk_ok(vm_2, e_1) then
       event GuestRan(x_1, s_1, c_1, e_1, vh_2, rh, vc, rc, vm_2, rm);
       return(zkprove(mkjournal(H(hk_1, actin(x_1)), s_1, c_1, e_1), zsk))
     ) | (
       foreach iV <= NV do
       cV(x_2: act_t, s_2: sid_t, c_2: hout, e_2: eps_t, gsig: signature, pf: zkproof) :=
       if check(mkgrant(s_2, c_2), pkP, gsig) then
       if policy_ok(e_2) then
       if zkverify(mkjournal(H(hk_1, actin(x_2)), s_2, c_2, e_2), img, pf) then
       event Accept(x_2, s_2, c_2, e_2);
       return()
     ))


