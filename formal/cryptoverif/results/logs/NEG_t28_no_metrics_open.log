       find u = ri <= NG suchthat defined(x_3[ri], e_1[ri], ah2[ri], ah1[ri], vh_2[ri], rh[ri], s_1[ri], x_1[ri]) && (x_2 = x_1[ri]) && (s_2 = s_1[ri]) && (nodein(l0[u_1], l1[u_1]) = nodein(H(hk_1, leafin(tH, rh[ri], vh_2[ri])), ah1[ri])) && (H(hk_1, nodein(l2[u_1], l3[u_1])) = ah2[ri]) && (e_2 = e_1[ri]) && check2_1(m1, pkgen2_1(zs), pf) then
       event Accept(x_2, s_2, c_2, e_2);
