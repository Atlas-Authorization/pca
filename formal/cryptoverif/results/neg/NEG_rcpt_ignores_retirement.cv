(* PCA Intent Layer v2 -- sequencer receipts AFTER the key-retirement fix (finding 1 of the 2026-10-12 CryptoVerif
   pass): a leaked RETIRED receipt-signing key buys nothing (CryptoVerif).

   Code modelled (packages/pca/src/intent-acc.ts verifyReceiptAgainstHolder, as fixed): besides everything in
   acc_receipt.cv, the verifier refuses a receipt older than maxReceiptAgeMs (15 min), a key set older than
   maxKeySetAgeMs (1 h) or below minKeySetVersion, and a key-set entry whose not_after is before now - 60 s.
   Time is not arithmetic in CryptoVerif, so retirement is a state: the sequencer marks a key EFFECTIVELY RETIRED
   (table `retired`) once (a) a key set with not_after for it is published, (b) 60 s of skew have passed, and (c) every
   older key set that lists the key without not_after is below minKeySetVersion or older than 1 h. Under the clock-skew
   assumption, the code's clock checks refuse exactly the entries of effectively retired keys, which is the
   verifier's `get retired(=spk)` below. The residual exposure window for a key leaked between retirement and
   effective retirement is therefore at most 60 s + 1 h (60 s when the verifier tracks minKeySetVersion).

   The threat that finding 1 was about: the key's secret LEAKS AFTER RETIREMENT. The corruption oracle releases a
   key seed only once the key is effectively retired.
   q_retired : an accepted receipt was issued by the sequencer with exactly these fields, with NO corruption escape.
   Negative control (the old behaviour): the verifier ignores retirement; q_retired is then not provable.
   Assumptions: UF-CMA (deterministic signer), CR of H, bounded clock skew. *)

param NK, NE, NR, NV, NO.

type keyseed [large, fixed].
type pkey [bounded].
type skey [bounded].
type signature.
type message.
type hashkey [fixed].
type digest [fixed].
type kid_t. type window_t. type sid_t. type accid_t. type seq_t. type aud_t. type rest_t. type act_t. type other_t.

proba Psign.
proba Psigncoll.
proba Phash.

expand UF_CMA_det_signature(keyseed, pkey, skey, message, signature, skgen, pkgen, sign, check, Psign, Psigncoll).
expand CollisionResistant_hash_1(hashkey, act_t, digest, hash, hash_oracle, Phash).

fun inwin(rest_t, window_t): bool.                 (* not_before <= issued_at <= not_after *)
fun mkentry(kid_t, pkey, window_t): message [data].                                    (* sequencer-keys/v1 *)
fun mkrcpt(sid_t, accid_t, seq_t, digest, aud_t, kid_t, rest_t): message [data].       (* acc-receipt/v1 *)
fun mkother(other_t): message [data].
equation forall k: kid_t, p: pkey, w: window_t, s: sid_t, a: accid_t, q: seq_t, d: digest, u: aud_t, k2: kid_t, r: rest_t;
  mkentry(k, p, w) <> mkrcpt(s, a, q, d, u, k2, r).
equation forall k: kid_t, p: pkey, w: window_t, o: other_t; mkentry(k, p, w) <> mkother(o).
equation forall s: sid_t, a: accid_t, q: seq_t, d: digest, u: aud_t, k2: kid_t, r: rest_t, o: other_t;
  mkrcpt(s, a, q, d, u, k2, r) <> mkother(o).

table accepted(sid_t, accid_t, seq_t).
table retired(pkey).

(* the root key is honest (uf_cma); the receipt-signing keys may be corrupted (uf_cma_corrupt, a manual step) *)
proof {
  crypto uf_cma(sign) rkR;
  crypto uf_cma_corrupt(sign) rk;
  auto
}

event EntrySigned(kid_t, pkey, window_t).
event Issued(pkey, sid_t, accid_t, seq_t, act_t, aud_t, kid_t, rest_t).
event CorruptKey(pkey).
event AcceptR(pkey, sid_t, accid_t, seq_t, act_t, aud_t, kid_t, rest_t).
event AcceptEntry(kid_t, pkey, window_t).
event AcceptD(digest, act_t).

(* the key-set entry used was signed by the sequencer root *)
query k: kid_t, p: pkey, w: window_t; event(AcceptEntry(k, p, w)) ==> event(EntrySigned(k, p, w)).
(* q_retired: no corruption escape -- a key that leaks only after its retirement is effective forges nothing *)
query p: pkey, s: sid_t, a: accid_t, q: seq_t, x: act_t, u: aud_t, k: kid_t, r: rest_t;
  event(AcceptR(p, s, a, q, x, u, k, r)) ==> event(Issued(p, s, a, q, x, u, k, r)).
query p: pkey, s: sid_t, a: accid_t, q: seq_t, x: act_t, u: aud_t, k: kid_t, r: rest_t;
  inj-event(AcceptR(p, s, a, q, x, u, k, r)) ==> inj-event(Issued(p, s, a, q, x, u, k, r)).
(* a receipt binds one action: two accepted actions with the same pcactn_digest are equal *)
query d: digest, x: act_t, x': act_t; event(AcceptD(d, x)) && event(AcceptD(d, x')) ==> x = x'.

channel c0, cT, cT2, cK, cK2, cE, cE2, cI, cI2, cC, cC2, cRo, cRo2, cV, cV2.

(* the sequencer: root key, NK rotating receipt-signing keys, each published in NE root-signed entries (any kid,
   any window the operator chooses) and issuing NR receipts (any values the reservation produces) *)
let Sequencer(hk: hashkey, skR: skey) =
  (! iO <= NO in(cRo, o: other_t); out(cRo2, sign(mkother(o), skR)))
  |
  ! iK <= NK
  in(cK, ());
  new rk: keyseed; let pk: pkey = pkgen(rk) in let sk: skey = skgen(rk) in
  out(cK2, pk);
  ( (! iE <= NE in(cE, (kid: kid_t, w: window_t)); event EntrySigned(kid, pk, w); out(cE2, sign(mkentry(kid, pk, w), skR)))
  | (! iI <= NR in(cI, (s: sid_t, a: accid_t, q: seq_t, x: act_t, u: aud_t, kid: kid_t, r: rest_t));
       event Issued(pk, s, a, q, x, u, kid, r);
       out(cI2, sign(mkrcpt(s, a, q, hash(hk, x), u, kid, r), sk)))
  | (in(cT, ()); insert retired(pk); out(cT2, ()))                 (* retirement becomes effective *)
  | (in(cC, ()); get retired(=pk) in event CorruptKey(pk); out(cC2, rk)) ).   (* the key leaks AFTER retirement *)

let Verifier(hk: hashkey, pkR: pkey) =
  ! iV <= NV
  in(cV, (s: sid_t, a: accid_t, u: aud_t, x: act_t,               (* this PCActn: session, claim id, aud, body *)
          q: seq_t, kid: kid_t, r: rest_t, spk: pkey, rsig: signature,
          w: window_t, esig: signature));
  if check(mkentry(kid, spk, w), pkR, esig) then
  if inwin(r, w) then
  let d = hash(hk, x) in
  if check(mkrcpt(s, a, q, d, u, kid, r), spk, rsig) then
  get accepted(=s, =a, =q) in yield else
  insert accepted(s, a, q);
  event AcceptEntry(kid, spk, w);
  event AcceptD(d, x);
  event AcceptR(spk, s, a, q, x, u, kid, r);
  out(cV2, ()).

process
  in(c0, ());
  new hk: hashkey;
  new rkR: keyseed; let pkR = pkgen(rkR) in let skR = skgen(rkR) in
  out(c0, pkR);
  ( hash_oracle(hk) | Sequencer(hk, skR) | Verifier(hk, pkR) )
