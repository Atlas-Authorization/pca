       foreach i_1 <= N do
       cD(par: hashout, hol: pkey, cv_2: caveat) :=
       cb_1: message <- mkcap(par, pkD, hol, cv_2);
       event Delegated(cb_1);
       return(cb_1, sign(cb_1, skD))
