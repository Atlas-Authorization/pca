(* PCA -- computational proof (CryptoVerif 2.13, channels front-end) of the core PCActn authorization chain
   at depth 1:  principal key kP signs the ROOT grant  cb = cap(pkH, caveat);  holder/agent key kH signs ANY
   action  act = act(aud, verb, res, grant_ref, ctr, nonce, exp)  (honest agent = prompt-injected worst case);
   the verifier accepts iff   check(cb, pkP, csg)  &&  grant_ref = H(hk, (cb, csg))  &&  check(act, holder(cb), asg).
   Assumptions: UF-CMA of the (deterministic) signature scheme (Ed25519-like) and collision resistance of H.
   Keys are NOT corrupted in this game (compromise is covered by the symbolic ProVerif/Tamarin models). *)

param N, N2.

type keyseed [large, fixed].
type pkey [bounded].
type skey [bounded].
type signature.
type message.                    (* signature input: cap / act encodings *)
type hashkey [fixed].
type hashout [fixed].
type capwire.                    (* the hashed object: (cb, csg) *)
type audience. type verb_t. type res_t. type ctr_t. type nonce_t. type exp_t. type caveat.

proba Psign.
proba Psigncoll.
proba Phash.

expand UF_CMA_det_signature(keyseed, pkey, skey, message, signature, skgen, pkgen, sign, check, Psign, Psigncoll).
expand CollisionResistant_hash_1(hashkey, capwire, hashout, hash, hash_oracle, Phash).

fun mkcap(pkey, caveat): message [data].
fun mkact(audience, verb_t, res_t, hashout, ctr_t, nonce_t, exp_t): message [data].
fun mkcw(message, signature): capwire [data].
equation forall p: pkey, c: caveat, a: audience, v: verb_t, r: res_t, g: hashout, k: ctr_t, n: nonce_t, e: exp_t;
  mkcap(p, c) <> mkact(a, v, r, g, k, n, e).

event Granted(message).                       (* principal signed this root grant *)
event Signed(message).                        (* honest agent signed this action *)
event Accept(message, hashout, message, pkey).   (* cb, grant_ref, act, holder named in cb *)

(* leaf signature authenticity: accepted action was signed by the honest agent *)
query cb: message, g: hashout, a: message, h: pkey;
  event(Accept(cb, g, a, h)) ==> event(Signed(a)).
(* authorization: accepted action rests on a root grant the principal signed *)
query cb: message, g: hashout, a: message, h: pkey;
  event(Accept(cb, g, a, h)) ==> event(Granted(cb)).
(* grant_ref binds ONE root grant (needs hash collision resistance) *)
query cb1: message, cb2: message, g: hashout, a1: message, a2: message, h1: pkey, h2: pkey;
  event(Accept(cb1, g, a1, h1)) && event(Accept(cb2, g, a2, h2)) ==> cb1 = cb2.

channel c0, cP, cP2, cA, cA2, cV, cV2.

let Principal(pkH: pkey, skP: skey) =
  ! N
  in(cP, cv: caveat);
  let cb = mkcap(pkH, cv) in
  event Granted(cb);
  out(cP2, (cb, sign(cb, skP))).

let Agent(skH: skey) =
  ! N
  in(cA, (aud: audience, vb: verb_t, rs: res_t, gref: hashout, ctr: ctr_t, nonce: nonce_t, ex: exp_t));
  let act = mkact(aud, vb, rs, gref, ctr, nonce, ex) in
  event Signed(act);
  out(cA2, sign(act, skH)).

let Verifier(hk: hashkey, pkP: pkey) =
  ! N
  in(cV, (cb: message, csg: signature, aud: audience, vb: verb_t, rs: res_t, gref: hashout, ctr: ctr_t, nonce: nonce_t, ex: exp_t, asg: signature));
  let mkcap(hol, cv) = cb in
  let act = mkact(aud, vb, rs, gref, ctr, nonce, ex) in
  if check(cb, pkP, csg) then
  if gref = hash(hk, mkcw(cb, csg)) then
  if check(act, hol, asg) then
  event Accept(cb, gref, act, hol);
  out(cV2, ()).

process
  in(c0, ());
  new hk: hashkey;
  new rkP: keyseed; let pkP = pkgen(rkP) in let skP = skgen(rkP) in
  new rkH: keyseed; let pkH = pkgen(rkH) in let skH = skgen(rkH) in
  out(c0, (pkP, pkH));
  ( hash_oracle(hk) | Principal(pkH, skP) | Agent(skH) | Verifier(hk, pkP) )
