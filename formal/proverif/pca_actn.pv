(* PCA -- PCActn verification flow, ProVerif port of formal/tamarin/pca_actn.spthy (ProVerif 2.05, typed pi).
   Same abstractions as the Tamarin model (see its header): capability = (body, sign(body, issuer)),
   body = (capT, parentLink, issuer, holder, caveat), parentLink = none | h(parent cap); caveat = verb pin | anyc;
   action = (actT, aud, verb, res, grant_ref, ctr, nonce, exp) signed by the LEAF holder; honest agents sign ANY
   action; Dolev-Yao attacker may reveal any honestly generated long-term key (event Reveal).
   Chains of depth 1, 2, 3 (three verifier processes).  Expiry is in pca_actn_expiry.pv (needs phases).
   VARIANTS are generated by gen.sh from the marker lines below:
     line ending (*-X*)   : deleted when generating variant X
     line starting (*+X*) : kept (marker stripped) only in variant X
   Variants: NO_GREF_CHECK NO_ANCESTOR_CAV NO_AUD_CHECK NO_LEAF_SIG SANITY (honest-only executability, no Reveal). *)

type key.
fun pk(bitstring): bitstring.
fun sign(bitstring, bitstring): bitstring.
fun verify(bitstring, bitstring, bitstring): bool
  reduc forall m: bitstring, k: bitstring; verify(sign(m, k), m, pk(k)) = true.
fun h(bitstring): bitstring.     (* collision-free, one-way hash: free constructor *)

const capT, actT, none, endm, anyc, ctrT, nonceT: bitstring [data].

free c: channel.
table keys(bitstring, bitstring).      (* honestly generated long-term keys: pk, sk *)
table nonces1(bitstring). table ctrs1(bitstring).                  (* TABLE_CHECK_INSERT variant stores  *)
table nonces2(bitstring, bitstring). table ctrs2(bitstring, bitstring).  (* TABLE_INSERT_FIRST variant stores *)

event KeyGen(bitstring).
event Reveal(bitstring).
event Granted(bitstring, bitstring, bitstring, bitstring).             (* issuer, holder, caveat, id(root cap) *)
event HonestDelegated(bitstring, bitstring, bitstring).                (* h(parent), h(child), caveat *)
event AgentSigned(bitstring, bitstring, bitstring, bitstring, bitstring).  (* pk, aud, nonce, ctr, verb *)
event HopWalk(bitstring, bitstring).
event Accept(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
(* vaud, aaud, rid, lhol, nonce, ctr, verb, iss, exp *)
event AcceptH(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).   (* Accept with an honestly generated leaf-holder key *)
event ConsumeN(bitstring, bitstring).        (* replay-store keys: (key, id of the verifier execution) *)
event AdvanceC(bitstring, bitstring, bitstring).
event AcceptS(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).   (* vaud, rid, lhol, nonce, ctr, execution id *)
(* ATOMIC replay store as a RESTRICTION (the exact analogue of Tamarin's OnceNonce / OnceCounter): two consumptions of
   the same key are the same verifier execution (execution id = fresh name `sid`).  The store invariant itself is in Lean. *)
restriction k, a, b: bitstring; event(ConsumeN(k, a)) && event(ConsumeN(k, b)) ==> a = b.   (*-NO_REPLAY_STORE,TABLE_CHECK_INSERT,TABLE_INSERT_FIRST*)
restriction s, ct, a, b: bitstring; event(AdvanceC(s, ct, a)) && event(AdvanceC(s, ct, b)) ==> a = b.   (*-NO_REPLAY_STORE,TABLE_CHECK_INSERT,TABLE_INSERT_FIRST*)
event ReachD1(). event ReachD2(). event ReachD3(). event ReachDelegated(). event Consumed(bitstring, bitstring, bitstring, bitstring).

(* ---------------- queries (mirror the Tamarin lemmas) ---------------- *)
(* authorization *)
(*Q:authorization*) query vaud, aaud, rid, lhol, n, cc, v, iss, e, pkH, cv: bitstring; event(Accept(vaud, aaud, rid, lhol, n, cc, v, iss, e)) ==> event(Granted(iss, pkH, cv, rid)) || event(Reveal(iss)).
(* leaf_signature_authenticity *)
(*Q:leaf_signature_authenticity*) query vaud, aaud, rid, lhol, n, cc, v, iss, e: bitstring; event(Accept(vaud, aaud, rid, lhol, n, cc, v, iss, e)) && event(KeyGen(lhol)) ==> event(AgentSigned(lhol, aaud, n, cc, v)) || event(Reveal(lhol)).
(* attenuation_root *)
(*Q:attenuation_root*) query vaud, aaud, rid, lhol, n, cc, v, iss, e, pkH, cv0: bitstring; event(Accept(vaud, aaud, rid, lhol, n, cc, v, iss, e)) && event(Granted(iss, pkH, cv0, rid)) ==> (cv0 = v || cv0 = anyc || event(Reveal(iss))).
(* attenuation_hop *)
(*Q:attenuation_hop*) query vaud, aaud, rid, lhol, n, cc, v, iss, e, hp, hc, cv1: bitstring; event(Accept(vaud, aaud, rid, lhol, n, cc, v, iss, e)) && event(HonestDelegated(hp, hc, cv1)) && event(HopWalk(hc, v)) ==> (cv1 = v || cv1 = anyc).
(* audience_binding *)
(*Q:audience_binding*) query vaud, aaud, rid, lhol, n, cc, v, iss, e: bitstring; event(Accept(vaud, aaud, rid, lhol, n, cc, v, iss, e)) ==> vaud = aaud.
(* replay_freedom_nonce / _counter: literal analogues of the Tamarin lemmas (two acceptances under the same
   (audience, ROOT grant id, leaf holder, nonce|counter) are one and the same verifier execution) *)
(*Q:replay_freedom_nonce*) query vaud, rid, lhol, n, c1, c2, s1, s2: bitstring; event(AcceptS(vaud, rid, lhol, n, c1, s1)) && event(AcceptS(vaud, rid, lhol, n, c2, s2)) ==> s1 = s2.
(*Q:replay_freedom_counter*) query vaud, rid, lhol, n1, n2, c, s1, s2: bitstring; event(AcceptS(vaud, rid, lhol, n1, c, s1)) && event(AcceptS(vaud, rid, lhol, n2, c, s2)) ==> s1 = s2.
(* replay_inj: INJECTIVE agreement -- every acceptance (honest leaf holder) consumes its own distinct agent signing *)
(*Q:replay_inj*) query vaud, aaud, rid, lhol, n, cc, v, iss, e: bitstring; inj-event(AcceptH(vaud, aaud, rid, lhol, n, cc, v, iss, e)) ==> inj-event(AgentSigned(lhol, aaud, n, cc, v)) || event(Reveal(lhol)).
(* sanity: reachability (ProVerif prints 'false' = the event IS reachable = model not vacuous) *)
(*+SANITY*) (*Q:sanity1*) query event(ReachD1()).
(*+SANITY*) (*Q:sanity2*) query event(ReachD2()).
(*+SANITY*) (*Q:sanity3*) query event(ReachD3()).
(*+SANITY*) (*Q:sanity4*) query event(ReachDelegated()).
(*+SANITY*) (*Q:sanity5*) query vaud, aaud, rid, lhol, n, cc, v, iss, e: bitstring; event(Accept(vaud, aaud, rid, lhol, n, cc, v, iss, e)).

(* ---------------- environment ---------------- *)
let KeyGenP() = new k: bitstring; insert keys(pk(k), k); event KeyGen(pk(k)); out(c, pk(k)).
let RevealP() = in(c, p: bitstring); get keys(=p, k) in event Reveal(p); out(c, k).

(* principal issues the ROOT grant; caveat is attacker-chosen *)
let PrincipalGrant() =
  in(c, (pkP: bitstring, pkH: bitstring, cv: bitstring));
  get keys(=pkP, ltkP) in get keys(=pkH, ltkH) in
  let body = (capT, none, pkP, pkH, cv) in
  let cap = (body, sign(body, ltkP)) in
  event Granted(pkP, pkH, cv, h(cap));
  out(c, cap).

(* honest delegation.  Bounded to the verifier's depth (3): an unbounded Delegate (its output fed back as its own
   input) makes ProVerif's saturation diverge on the term family h(h(h(..))).
   Delegate1 extends a ROOT capability (parent link none); Delegate2 extends a capability whose parent is a ROOT. *)
let Delegate1() =
  in(c, (pcap: bitstring, pkE: bitstring, cv: bitstring));
  let ((=capT, =none, piss: bitstring, pkD: bitstring, pcv: bitstring), psg: bitstring) = pcap in
  get keys(=pkD, ltkD) in
  if verify(psg, (capT, none, piss, pkD, pcv), piss) = true then
  let body = (capT, h(pcap), pkD, pkE, cv) in
  let cap = (body, sign(body, ltkD)) in
  event HonestDelegated(h(pcap), h(cap), cv);
  event ReachDelegated();
  out(c, cap).
let Delegate2() =
  in(c, (pcap: bitstring, gcap: bitstring, pkE: bitstring, cv: bitstring));
  let ((=capT, =none, giss: bitstring, ghol: bitstring, gcv: bitstring), gsg: bitstring) = gcap in
  let ((=capT, =h(gcap), piss: bitstring, pkD: bitstring, pcv: bitstring), psg: bitstring) = pcap in
  get keys(=pkD, ltkD) in
  if verify(psg, (capT, h(gcap), piss, pkD, pcv), piss) = true then
  let body = (capT, h(pcap), pkD, pkE, cv) in
  let cap = (body, sign(body, ltkD)) in
  event HonestDelegated(h(pcap), h(cap), cv);
  out(c, cap).

(* honest agent signs ANY action (prompt-injected worst case) *)
let AgentAct() =
  in(c, (chain: bitstring, pkH: bitstring, aud: bitstring, verb: bitstring, res: bitstring, gref: bitstring, ctr: bitstring, nonce: bitstring, exp: bitstring));
  get keys(=pkH, ltkH) in
  let act = (actT, aud, verb, res, gref, ctr, nonce, exp) in
  event AgentSigned(pkH, aud, nonce, ctr, verb);
  out(c, (chain, act, sign(act, ltkH))).

(* ---------------- verifier (normative order of pcactn.ts) ---------------- *)
let Verify1(vaud: bitstring, pkT: bitstring) =
  in(c, ((c1: bitstring, =endm), (=actT, aaud: bitstring, verb: bitstring, res: bitstring, gref: bitstring, ctr: bitstring, nonce: bitstring, exp: bitstring), asig: bitstring));
  let ((=capT, par1: bitstring, iss1: bitstring, hol1: bitstring, cv1: bitstring), sg1: bitstring) = c1 in
  let act = (actT, aaud, verb, res, gref, ctr, nonce, exp) in
  if verify(asig, act, hol1) = true then                                  (*-NO_LEAF_SIG*)
  if aaud = vaud then                                                      (*-NO_AUD_CHECK*)
  if verify(sg1, (capT, par1, iss1, hol1, cv1), iss1) = true then
  if cv1 = verb || cv1 = anyc then
  if par1 = none then
  if iss1 = pkT then   (*-NO_TRUST_ANCHOR*)
  if gref = h(c1) then                                                     (*-NO_GREF_CHECK*)
  new sid1: bitstring;
  event ConsumeN((vaud, gref, hol1, nonce), sid1);   (*-TABLE_CHECK_INSERT,TABLE_INSERT_FIRST*)
  event AdvanceC((vaud, gref, hol1), ctr, sid1);     (*-TABLE_CHECK_INSERT,TABLE_INSERT_FIRST*)
(*+TABLE_CHECK_INSERT*)  get nonces1(=(vaud, gref, hol1, nonce)) in 0 else
(*+TABLE_CHECK_INSERT*)  get ctrs1(=(vaud, gref, hol1, ctr)) in 0 else
(*+TABLE_CHECK_INSERT*)  insert nonces1((vaud, gref, hol1, nonce));
(*+TABLE_CHECK_INSERT*)  insert ctrs1((vaud, gref, hol1, ctr));
(*+TABLE_INSERT_FIRST*)  insert nonces2((vaud, gref, hol1, nonce), sid1);
(*+TABLE_INSERT_FIRST*)  get nonces2(=(vaud, gref, hol1, nonce), o1: bitstring) suchthat o1 <> sid1 in 0 else
(*+TABLE_INSERT_FIRST*)  insert ctrs2((vaud, gref, hol1, ctr), sid1);
(*+TABLE_INSERT_FIRST*)  get ctrs2(=(vaud, gref, hol1, ctr), o2: bitstring) suchthat o2 <> sid1 in 0 else
  event ReachD1();
  event HopWalk(h(c1), verb);
  event AcceptS(vaud, h(c1), hol1, nonce, ctr, sid1);
  event Accept(vaud, aaud, h(c1), hol1, nonce, ctr, verb, iss1, exp);
  get keys(=hol1, lh) in
  event AcceptH(vaud, aaud, h(c1), hol1, nonce, ctr, verb, iss1, exp).

let Verify2(vaud: bitstring, pkT: bitstring) =
  in(c, ((c1: bitstring, (c2: bitstring, =endm)), (=actT, aaud: bitstring, verb: bitstring, res: bitstring, gref: bitstring, ctr: bitstring, nonce: bitstring, exp: bitstring), asig: bitstring));
  let ((=capT, par1: bitstring, iss1: bitstring, hol1: bitstring, cv1: bitstring), sg1: bitstring) = c1 in
  let ((=capT, par2: bitstring, iss2: bitstring, hol2: bitstring, cv2: bitstring), sg2: bitstring) = c2 in
  let act = (actT, aaud, verb, res, gref, ctr, nonce, exp) in
  if verify(asig, act, hol1) = true then                                  (*-NO_LEAF_SIG*)
  if aaud = vaud then                                                      (*-NO_AUD_CHECK*)
  if verify(sg1, (capT, par1, iss1, hol1, cv1), iss1) = true then
  if cv1 = verb || cv1 = anyc then
  if par1 = h(c2) then
  if iss1 = hol2 then
  if verify(sg2, (capT, par2, iss2, hol2, cv2), iss2) = true then
  if cv2 = verb || cv2 = anyc then                                         (*-NO_ANCESTOR_CAV*)
  if par2 = none then
  if iss2 = pkT then   (*-NO_TRUST_ANCHOR*)
  if gref = h(c2) then                                                     (*-NO_GREF_CHECK*)
  new sid2: bitstring;
  event ConsumeN((vaud, gref, hol1, nonce), sid2);   (*-TABLE_CHECK_INSERT,TABLE_INSERT_FIRST*)
  event AdvanceC((vaud, gref, hol1), ctr, sid2);     (*-TABLE_CHECK_INSERT,TABLE_INSERT_FIRST*)
(*+TABLE_CHECK_INSERT*)  get nonces1(=(vaud, gref, hol1, nonce)) in 0 else
(*+TABLE_CHECK_INSERT*)  get ctrs1(=(vaud, gref, hol1, ctr)) in 0 else
(*+TABLE_CHECK_INSERT*)  insert nonces1((vaud, gref, hol1, nonce));
(*+TABLE_CHECK_INSERT*)  insert ctrs1((vaud, gref, hol1, ctr));
(*+TABLE_INSERT_FIRST*)  insert nonces2((vaud, gref, hol1, nonce), sid2);
(*+TABLE_INSERT_FIRST*)  get nonces2(=(vaud, gref, hol1, nonce), o1: bitstring) suchthat o1 <> sid2 in 0 else
(*+TABLE_INSERT_FIRST*)  insert ctrs2((vaud, gref, hol1, ctr), sid2);
(*+TABLE_INSERT_FIRST*)  get ctrs2(=(vaud, gref, hol1, ctr), o2: bitstring) suchthat o2 <> sid2 in 0 else
  event ReachD2();
  event HopWalk(h(c1), verb);
  event HopWalk(h(c2), verb);
  event AcceptS(vaud, h(c2), hol1, nonce, ctr, sid2);
  event Accept(vaud, aaud, h(c2), hol1, nonce, ctr, verb, iss2, exp);
  get keys(=hol1, lh) in
  event AcceptH(vaud, aaud, h(c2), hol1, nonce, ctr, verb, iss2, exp).

let Verify3(vaud: bitstring, pkT: bitstring) =
  in(c, ((c1: bitstring, (c2: bitstring, (c3: bitstring, =endm))), (=actT, aaud: bitstring, verb: bitstring, res: bitstring, gref: bitstring, ctr: bitstring, nonce: bitstring, exp: bitstring), asig: bitstring));
  let ((=capT, par1: bitstring, iss1: bitstring, hol1: bitstring, cv1: bitstring), sg1: bitstring) = c1 in
  let ((=capT, par2: bitstring, iss2: bitstring, hol2: bitstring, cv2: bitstring), sg2: bitstring) = c2 in
  let ((=capT, par3: bitstring, iss3: bitstring, hol3: bitstring, cv3: bitstring), sg3: bitstring) = c3 in
  let act = (actT, aaud, verb, res, gref, ctr, nonce, exp) in
  if verify(asig, act, hol1) = true then                                  (*-NO_LEAF_SIG*)
  if aaud = vaud then                                                      (*-NO_AUD_CHECK*)
  if verify(sg1, (capT, par1, iss1, hol1, cv1), iss1) = true then
  if cv1 = verb || cv1 = anyc then
  if par1 = h(c2) then
  if iss1 = hol2 then
  if verify(sg2, (capT, par2, iss2, hol2, cv2), iss2) = true then
  if cv2 = verb || cv2 = anyc then                                         (*-NO_ANCESTOR_CAV*)
  if par2 = h(c3) then
  if iss2 = hol3 then
  if verify(sg3, (capT, par3, iss3, hol3, cv3), iss3) = true then
  if cv3 = verb || cv3 = anyc then                                         (*-NO_ANCESTOR_CAV*)
  if par3 = none then
  if iss3 = pkT then   (*-NO_TRUST_ANCHOR*)
  if gref = h(c3) then                                                     (*-NO_GREF_CHECK*)
  new sid3: bitstring;
  event ConsumeN((vaud, gref, hol1, nonce), sid3);   (*-TABLE_CHECK_INSERT,TABLE_INSERT_FIRST*)
  event AdvanceC((vaud, gref, hol1), ctr, sid3);     (*-TABLE_CHECK_INSERT,TABLE_INSERT_FIRST*)
(*+TABLE_CHECK_INSERT*)  get nonces1(=(vaud, gref, hol1, nonce)) in 0 else
(*+TABLE_CHECK_INSERT*)  get ctrs1(=(vaud, gref, hol1, ctr)) in 0 else
(*+TABLE_CHECK_INSERT*)  insert nonces1((vaud, gref, hol1, nonce));
(*+TABLE_CHECK_INSERT*)  insert ctrs1((vaud, gref, hol1, ctr));
(*+TABLE_INSERT_FIRST*)  insert nonces2((vaud, gref, hol1, nonce), sid3);
(*+TABLE_INSERT_FIRST*)  get nonces2(=(vaud, gref, hol1, nonce), o1: bitstring) suchthat o1 <> sid3 in 0 else
(*+TABLE_INSERT_FIRST*)  insert ctrs2((vaud, gref, hol1, ctr), sid3);
(*+TABLE_INSERT_FIRST*)  get ctrs2(=(vaud, gref, hol1, ctr), o2: bitstring) suchthat o2 <> sid3 in 0 else
  event ReachD3();
  event HopWalk(h(c1), verb);
  event HopWalk(h(c2), verb);
  event HopWalk(h(c3), verb);
  event AcceptS(vaud, h(c3), hol1, nonce, ctr, sid3);
  event Accept(vaud, aaud, h(c3), hol1, nonce, ctr, verb, iss3, exp);
  get keys(=hol1, lh) in
  event AcceptH(vaud, aaud, h(c3), hol1, nonce, ctr, verb, iss3, exp).

(* verifier configuration: audience (attacker-chosen) + trust anchor (an honestly generated key) *)
let Verifier() =
  in(c, (vaud: bitstring, pkT: bitstring));
  get keys(=pkT, ltkT) in
  ( Verify1(vaud, pkT) | Verify2(vaud, pkT) | Verify3(vaud, pkT) ).

process
  !KeyGenP() | !PrincipalGrant() | !Delegate1() | !Delegate2() | !AgentAct() | !Verifier()
  | !RevealP()                                                            (*-SANITY*)
