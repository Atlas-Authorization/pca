import PcaMath.Alg

/-!
# RP-7: the range proof is zero knowledge (programmed-challenge form), as an exact coupling

For fixed challenges `e j` (one per bit proof) and `ea` (aggregation proof), the real prover and the
simulator both biject (from uniform sources) onto the SAME set `Valid` of accepting transcripts, so their
output distributions are equal.  The simulator needs neither the bits nor the blindings: it samples the bit
commitments `B j` uniformly, the OR-proof triples uniformly and the aggregation response `z` uniformly.

(Why this is the NIZK statement in the programmable ROM: the simulator programs the oracle so that the
challenge of each sigma proof is the `e j` / `ea` it fixed in advance; the rest is this bijection.)
Hypotheses: `H` spans the group (`hspan`) and is nonzero, i.e. the group has prime order generated by `H`.
-/

namespace PcaMath.Nizk

open PcaMath.Alg

variable {F G : Type*} [Field F] [AddCommGroup G] [Module F G]

theorem smul_inj (Hh : G) (hH : Hh ≠ 0) : Function.Injective (fun s : F => s • Hh) := by
  intro a b h
  by_contra hne
  have : (a - b) • Hh = 0 := by simpa [sub_smul, sub_eq_zero] using h
  rcases smul_eq_zero.mp this with h1 | h1
  · exact hne (sub_eq_zero.mp h1)
  · exact hH h1

variable (Gg Hh : G) (n : ℕ) (V : G) (e : Fin n → F) (ea : F)

/-- statement-dependent point `D = Σ 2^j B_j - V` -/
def Dpt (B : Fin n → G) : G := (∑ j : Fin n, ((2 : F) ^ (j : ℕ)) • B j) - V

/-- accepting transcripts for the fixed challenges -/
def Valid : Set ((Fin n → G) × (Fin n → F × F × F × F) × (G × F)) :=
  {t | (∀ j, t.2.1 j ∈ OrSet (e j)) ∧ t.2.2.2 • Hh = t.2.2.1 + ea • Dpt (F := F) n V t.1}


abbrev RSrc (F : Type*) (n : ℕ) := (Fin n → F) × (Fin n → F × F × F) × F
abbrev SSrc (F G : Type*) (n : ℕ) := (Fin n → G) × (Fin n → F × F × F) × F

/-- real prover for bits `b`, blinding-of-`V` `γ`; sources: bit blindings `s`, OR randomness `r`, Schnorr nonce `k`. -/
def realMap (b : Fin n → Bool) (γ : F) (x : RSrc F n) :
    (Fin n → G) × (Fin n → F × F × F × F) × (G × F) :=
  (fun j => (if b j then (1 : F) else 0) • Gg + x.1 j • Hh,
   fun j => orProve (b j) (x.1 j) (x.2.1 j).1 (x.2.1 j).2.1 (x.2.1 j).2.2 (e j),
   (x.2.2 • Hh, x.2.2 + ea * ((∑ j : Fin n, (2 : F) ^ (j : ℕ) * x.1 j) - γ)))

/-- simulator: no bits, no blindings. -/
def simMap (x : SSrc F G n) : (Fin n → G) × (Fin n → F × F × F × F) × (G × F) :=
  (x.1, fun j => orSim (e j) (x.2.1 j), (x.2.2 • Hh - ea • Dpt (F := F) n V x.1, x.2.2))

theorem sim_valid (x : SSrc F G n) : simMap Hh n V e ea x ∈ Valid Hh n V e ea := by
  refine ⟨fun j => orSim_mem (e j) (x.2.1 j), ?_⟩
  simp [simMap]

theorem sim_inj : Function.Injective (simMap (F := F) Hh n V e ea) := by
  rintro ⟨B, x, z⟩ ⟨B', x', z'⟩ h
  simp only [simMap, Prod.mk.injEq] at h
  obtain ⟨hB, hx, _, hz⟩ := h
  subst hB; subst hz
  have : x = x' := by
    funext j
    exact orSim_injective (e j) (congrFun hx j)
  subst this; rfl

theorem sim_surj : ∀ t ∈ Valid Hh n V e ea, ∃ x : SSrc F G n, simMap Hh n V e ea x = t := by
  rintro ⟨B, T, a, z⟩ ⟨hT, hagg⟩
  have hx : ∀ j, ∃ y : F × F × F, orSim (e j) y = T j := fun j => orSim_surjective (e j) (T j) (hT j)
  choose x hxs using hx
  refine ⟨(B, x, z), ?_⟩
  simp only [simMap, Prod.mk.injEq, true_and]
  refine ⟨funext hxs, ?_⟩
  have : a = z • Hh - ea • Dpt (F := F) n V B := by
    simp only at hagg
    rw [hagg]; abel
  rw [this]; exact ⟨rfl, trivial⟩

/-- The simulator and the (honest-witness) real prover are both bijections from their uniform sources onto
the same set of accepting transcripts. -/
theorem rp7_simulator_bijection :
    Function.Bijective (fun x : SSrc F G n => (⟨simMap Hh n V e ea x, sim_valid Hh n V e ea x⟩ :
      Valid Hh n V e ea)) := by
  refine ⟨?_, ?_⟩
  · intro x y h
    exact sim_inj Hh n V e ea (congrArg Subtype.val h)
  · rintro ⟨t, ht⟩
    obtain ⟨x, hx⟩ := sim_surj Hh n V e ea t ht
    exact ⟨x, Subtype.ext hx⟩


section Real
variable (b : Fin n → Bool) (γ : F)
  (hV : V = (∑ j : Fin n, (2 : F) ^ (j : ℕ) * (if b j then (1 : F) else 0)) • Gg + γ • Hh)

include hV in
theorem real_D (s : Fin n → F) :
    Dpt (F := F) n V (fun j => (if b j then (1 : F) else 0) • Gg + s j • Hh)
      = ((∑ j : Fin n, (2 : F) ^ (j : ℕ) * s j) - γ) • Hh := by
  have h := range_agg_complete (F := F) Gg Hh n b s γ
  dsimp only at h
  unfold Dpt
  rw [hV]
  exact h

include hV in
theorem real_valid (x : RSrc F n) : realMap Gg Hh n e ea b γ x ∈ Valid Hh n V e ea := by
  refine ⟨fun j => ?_, ?_⟩
  · exact orProve_mem _ _ _ _ _ _
  · simp only [realMap]
    rw [real_D Gg Hh n V b γ hV x.1]
    rw [add_smul, mul_smul]

theorem real_inj (hH : Hh ≠ 0) : Function.Injective (realMap (F := F) Gg Hh n e ea b γ) := by
  rintro ⟨s, r, k⟩ ⟨s', r', k'⟩ h
  simp only [realMap, Prod.mk.injEq] at h
  obtain ⟨hB, hT, hA, _⟩ := h
  have hs : s = s' := by
    funext j
    have := congrFun hB j
    exact smul_inj Hh hH (add_left_cancel (a := (if b j then (1 : F) else 0) • Gg) this)
  subst hs
  have hr : r = r' := by
    funext j
    have := congrFun hT j
    exact orProve_injective (b j) (s j) (e j) (by simpa using this)
  subst hr
  have hk : k = k' := smul_inj Hh hH hA
  subst hk; rfl

include hV in
theorem real_surj (hH : Hh ≠ 0) (hspan : ∀ g : G, ∃ s : F, g = s • Hh) :
    ∀ t ∈ Valid Hh n V e ea, ∃ x : RSrc F n, realMap Gg Hh n e ea b γ x = t := by
  rintro ⟨B, T, a, z⟩ ⟨hT, hagg⟩
  have hs : ∀ j, ∃ s : F, B j = (if b j then (1 : F) else 0) • Gg + s • Hh := by
    intro j
    obtain ⟨s, hs⟩ := hspan (B j - (if b j then (1 : F) else 0) • Gg)
    exact ⟨s, by rw [← hs]; abel⟩
  choose s hsB using hs
  have hr : ∀ j, ∃ y : F × F × F, orProve (b j) (s j) y.1 y.2.1 y.2.2 (e j) = T j :=
    fun j => orProve_surjective (b j) (s j) (e j) (T j) (hT j)
  choose r hrs using hr
  obtain ⟨k, hk⟩ := hspan a
  refine ⟨(s, r, k), ?_⟩
  have hBeq : (fun j => (if b j then (1 : F) else 0) • Gg + s j • Hh) = B := funext fun j => (hsB j).symm
  have hD := real_D Gg Hh n V b γ hV s
  rw [hBeq] at hD
  simp only [realMap, Prod.mk.injEq]
  refine ⟨hBeq, funext hrs, hk.symm, ?_⟩
  simp only at hagg
  rw [hD, hk] at hagg
  have : (z - (k + ea * ((∑ j : Fin n, (2 : F) ^ (j : ℕ) * s j) - γ))) • Hh = 0 := by
    rw [sub_smul, add_smul, mul_smul]; rw [hagg]; abel
  have h0 := smul_eq_zero.mp this
  rcases h0 with h0 | h0
  · exact (sub_eq_zero.mp h0).symm
  · exact absurd h0 hH

end Real

theorem rp7_real_bijection (b : Fin n → Bool) (γ : F)
    (hV : V = (∑ j : Fin n, (2 : F) ^ (j : ℕ) * (if b j then (1 : F) else 0)) • Gg + γ • Hh)
    (hH : Hh ≠ 0) (hspan : ∀ g : G, ∃ s : F, g = s • Hh) :
    Function.Bijective (fun x : RSrc F n => (⟨realMap Gg Hh n e ea b γ x, real_valid Gg Hh n V e ea b γ hV x⟩ :
      Valid Hh n V e ea)) := by
  refine ⟨?_, ?_⟩
  · intro x y h
    exact real_inj Gg Hh n e ea b γ hH (congrArg Subtype.val h)
  · rintro ⟨t, ht⟩
    obtain ⟨x, hx⟩ := real_surj Gg Hh n V e ea b γ hV hH hspan t ht
    exact ⟨x, Subtype.ext hx⟩

/-- **RP-7 (exact).**  Real prover (any bits and blindings consistent with the statement `V`) and simulator are
both bijections from uniform sources onto the same set of accepting transcripts, and the sources have the same
size (the group is in bijection with the scalars): the transcript distributions are equal. -/
theorem rp7 (b : Fin n → Bool) (γ : F)
    (hV : V = (∑ j : Fin n, (2 : F) ^ (j : ℕ) * (if b j then (1 : F) else 0)) • Gg + γ • Hh)
    (hH : Hh ≠ 0) (hspan : ∀ g : G, ∃ s : F, g = s • Hh) :
    Function.Bijective (fun x : RSrc F n => (⟨realMap Gg Hh n e ea b γ x, real_valid Gg Hh n V e ea b γ hV x⟩ :
      Valid Hh n V e ea)) ∧
    Function.Bijective (fun x : SSrc F G n => (⟨simMap Hh n V e ea x, sim_valid Hh n V e ea x⟩ :
      Valid Hh n V e ea)) ∧
    Function.Bijective (fun s : F => s • Hh) :=
  ⟨rp7_real_bijection Gg Hh n V e ea b γ hV hH hspan, rp7_simulator_bijection Hh n V e ea,
   ⟨smul_inj Hh hH, fun g => (hspan g).imp fun s h => h.symm⟩⟩

end PcaMath.Nizk
