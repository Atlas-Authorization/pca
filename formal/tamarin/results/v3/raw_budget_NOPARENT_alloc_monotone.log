theory PCA_Budget_V3

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

/* looping facts with injective instances: Debit/3 */

rule (modulo E) Tables:
   [ ]
  -->
   [
   !Dec( 'c3', 'c2' ), !Dec( 'c2', 'c1' ), !Dec( 'c1', 'c0' ),
   !Le( 'c0', 'c0' ), !Le( 'c0', 'c1' ), !Le( 'c0', 'c2' ),
   !Le( 'c0', 'c3' ), !Le( 'c1', 'c1' ), !Le( 'c1', 'c2' ),
   !Le( 'c1', 'c3' ), !Le( 'c2', 'c2' ), !Le( 'c2', 'c3' ),
   !Le( 'c3', 'c3' )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Root_Grant:
   [ Fr( ~r ) ]
  --[ RootNode( ~r, 'c2' ) ]->
   [ !IsRoot( ~r ), !Lim( ~r, 'c2' ), Cnt( ~r, 'c2' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Alloc_Child_R:
   [ !IsRoot( p ), !Lim( p, plim ), In( climit ), Fr( ~id ) ]
  --[ Alloc( <~id, p, p>, climit, p, plim ) ]->
   [
   !Lim( <~id, p, p>, climit ), !Node( <~id, p, p> ),
   Cnt( <~id, p, p>, climit )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) Alloc_Child_D:
   [ !Lim( <pid, pp, r>, plim ), In( climit ), Fr( ~id ) ]
  --[ Alloc( <~id, <pid, pp, r>, r>, climit, <pid, pp, r>, plim ) ]->
   [
   !Lim( <~id, <pid, pp, r>, r>, climit ), !Node( <~id, <pid, pp, r>, r> ),
   Cnt( <~id, <pid, pp, r>, r>, climit )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Spend_Begin_Root:
   [ !IsRoot( r ), Fr( ~sid ) ]
  --[ SpendBegin( ~sid, r ) ]->
   [ Debit( ~sid, r, r ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Spend_Begin_Node:
   [ !Node( <id, p, r> ), Fr( ~sid ) ]
  --[ SpendBegin( ~sid, <id, p, r> ) ]->
   [ Debit( ~sid, <id, p, r>, r ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Debit_Mid:
   [ Debit( sid, <id, p, r>, r ), Cnt( <id, p, r>, c ), !Dec( c, c1 ) ]
  --[ Debited( sid, <id, p, r>, r ), DebitFrom( <id, p, r>, c ) ]->
   [ Cnt( <id, p, r>, c1 ), Debit( sid, p, r ) ]

  // loop breakers: [1,0]
  /* has exactly the trivial AC variant */

rule (modulo E) Debit_Root:
   [ Debit( sid, r, r ), !IsRoot( r ), Cnt( r, c ), !Dec( c, c1 ) ]
  --[ Debited( sid, r, r ), DebitFrom( r, c ), Spent( sid, r ) ]->
   [ Cnt( r, c1 ) ]

  // loop breaker: [2]
  /* has exactly the trivial AC variant */

lemma executable_spend:
  exists-trace "∃ s r #i. Spent( s, r ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ s r #i. (Spent( s, r ) @ #i)"
*/
by sorry

lemma executable_two_spends:
  exists-trace
  "∃ s1 s2 r #i #j.
    ((Spent( s1, r ) @ #i) ∧ (Spent( s2, r ) @ #j)) ∧ (¬(s1 = s2))"
/*
guarded formula characterizing all satisfying traces:
"∃ s1 s2 r #i #j.
  (Spent( s1, r ) @ #i) ∧ (Spent( s2, r ) @ #j) ∧ ¬(s1 = s2)"
*/
by sorry

lemma executable_deep_spend:
  exists-trace
  "∃ s r n1 n2 n3 #a #b #c #d #e #f #x1 #x2 #x3 #x4.
    (((((((((RootNode( r, 'c2' ) @ #a) ∧ (Alloc( n1, 'c2', r, 'c2' ) @ #b)) ∧
           (Alloc( n2, 'c2', n1, 'c2' ) @ #c)) ∧
          (Alloc( n3, 'c2', n2, 'c2' ) @ #d)) ∧
         (SpendBegin( s, n3 ) @ #e)) ∧
        (Debited( s, n3, r ) @ #x1)) ∧
       (Debited( s, n2, r ) @ #x2)) ∧
      (Debited( s, n1, r ) @ #x3)) ∧
     (Debited( s, r, r ) @ #x4)) ∧
    (Spent( s, r ) @ #f)"
/*
guarded formula characterizing all satisfying traces:
"∃ s r n1 n2 n3 #a #b #c #d #e #f #x1 #x2 #x3 #x4.
  (RootNode( r, 'c2' ) @ #a) ∧
  (Alloc( n1, 'c2', r, 'c2' ) @ #b) ∧
  (Alloc( n2, 'c2', n1, 'c2' ) @ #c) ∧
  (Alloc( n3, 'c2', n2, 'c2' ) @ #d) ∧
  (SpendBegin( s, n3 ) @ #e) ∧
  (Debited( s, n3, r ) @ #x1) ∧
  (Debited( s, n2, r ) @ #x2) ∧
  (Debited( s, n1, r ) @ #x3) ∧
  (Debited( s, r, r ) @ #x4) ∧
  (Spent( s, r ) @ #f)"
*/
by sorry

lemma alloc_monotone:
  all-traces
  "∀ n cl p pl #i.
    (Alloc( n, cl, p, pl ) @ #i) ⇒
    (¬((((cl = 'c1') ∧ (pl = 'c0')) ∨
        ((cl = 'c2') ∧ ((pl = 'c0') ∨ (pl = 'c1')))) ∨
       ((cl = 'c3') ∧ (((pl = 'c0') ∨ (pl = 'c1')) ∨ (pl = 'c2')))))"
/*
guarded formula characterizing all counter-examples:
"∃ n cl p pl #i.
  (Alloc( n, cl, p, pl ) @ #i)
 ∧
  (((cl = 'c1') ∧ (pl = 'c0')) ∨
   ((cl = 'c2') ∧ (((pl = 'c0') ∨ (pl = 'c1')))) ∨
   ((cl = 'c3') ∧ (((pl = 'c0') ∨ (pl = 'c1') ∨ (pl = 'c2')))))"
*/
simplify
solve( Alloc( n, cl, p, pl ) @ #i )
  case Alloc_Child_D
  solve( !Lim( <pid, pp, r>, pl ) ▶₀ #i )
    case Alloc_Child_D
    solve( !Lim( <pid, pp, r>, plim ) ▶₀ #vr )
      case Alloc_Child_D
      solve( !Lim( <pid, pp, r>, plim.1 ) ▶₀ #vr.1 )
        case Alloc_Child_R
        solve( !Lim( ~r, plim.2 ) ▶₁ #vr.2 )
          case Root_Grant
          solve( ((cl = 'c1') ∧ (pl = 'c0'))  ∥
                 ((cl = 'c2') ∧ (((pl = 'c0') ∨ (pl = 'c1'))))  ∥
                 ((cl = 'c3') ∧ (((pl = 'c0') ∨ (pl = 'c1') ∨ (pl = 'c2')))) )
            case case_1
            SOLVED // trace found
          qed
        qed
      qed
    qed
  qed
qed

